parameters:
    level: 6
    paths:
        - src
    # WordPress core function/class stubs (WP is not a Composer dependency).
    bootstrapFiles:
        - vendor/php-stubs/wordpress-stubs/wordpress-stubs.php
    # middag-io libs live under vendor/ and are fully typed — analyse against them.
    treatPhpDocTypesAsCertain: false
    # No baseline: new code stays clean (contrast O5-MA-10, account's ~163KB baseline).
    reportUnmatchedIgnoredErrors: true
