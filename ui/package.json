{
  "name": "middag-boilerplate-ui",
  "private": true,
  "type": "module",
  "description": "Admin UI for the MIDDAG WordPress plugin boilerplate — React 19 + Inertia v3 + @middag-io/react.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:wp": "vite build --config vite.config.wordpress.ts",
    "watch:wp": "vite build --watch --config vite.config.wordpress.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@inertiajs/core": "^3.0.0",
    "@inertiajs/react": "^3.0.0",
    "@middag-io/react": "^0.36.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/jest-dom": "^6.9.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^25.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.5.0",
    "jsdom": "^29.0.0",
    "prettier": "^3.0.0",
    "prettier-plugin-tailwindcss": "^0.6.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^4.0.0"
  }
}
